{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/flow-notify.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cat .claude/state/flow.json:*)",
      "Bash(echo:*)",
      "Bash(mkdir -p .claude/state:*)",
      "Bash(jq:*)"
    ]
  }
}
